NODE_ENV=development
# Required for pnpm dev/start: choose an available local port. No team default.
PORT=
# Required only for Docker host publication: choose an available local DB port.
POSTGRES_HOST_PORT=
# Set DATABASE_URL only when using the local DB; match POSTGRES_HOST_PORT.
# DATABASE_URL=postgres://caregap:local-only@127.0.0.1:<chosen-db-port>/caregap_local
DEV_AUTH_ENABLED=false

# Phase 2 FCM (fail-closed). Never commit real service-account JSON.
# FCM_ENABLED=false keeps real Firebase calls off. Do not auto-fallback to Mock in production.
FCM_ENABLED=false
# FIREBASE_PROJECT_ID=
# Prefer Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS.
# FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Phase 3 call prototype (LiveKit Cloud). Server-only secrets — never ship to clients.
# LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Local demo harness (forbidden when NODE_ENV=production). Not mounted on src/app.ts.
CALL_PROTOTYPE_ENABLED=true
# CALL_PROTOTYPE_PORT=4091

# Phase 3B secure staging (Render / public HTTPS). Separate from local demo.
# CALL_STAGING_ENABLED=true
# CALL_STAGING_BIND_HOST=0.0.0.0
# CALL_STAGING_TRUST_PROXY=true
# CALL_STAGING_TOKEN_SECRET=replace-with-32+-char-random-secret
# CALL_STAGING_STAFF_USERNAME=
# CALL_STAGING_STAFF_PASSWORD=
# CALL_STAGING_PATIENT_USERNAME=
# CALL_STAGING_PATIENT_PASSWORD=
# CALL_STAGING_ALLOWED_ORIGINS=https://your-web-origin.example
# CALL_STAGING_ACCESS_TOKEN_TTL_SECONDS=3600
